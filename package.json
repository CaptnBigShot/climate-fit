{
  "name": "climate-fit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-data.mjs",
    "verify-s3": "node scripts/verify-s3.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "review-page": "node scripts/review-page.mjs",
    "nightly": "node scripts/nightly.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "basemap": "node scripts/build-basemap.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@openmeteo/file-reader": "0.0.18",
    "@photostructure/tz-lookup": "11.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
